#!ipxe

echo ===================================================
echo Initializing USB and Network Subsystems...
echo Ensure USB Tethering is enabled on your phone.
echo ===================================================

# Bring up USB controller drivers (ignores errors if already active)
usb || echo USB subsystem already initialized.

# Allow 2 seconds for the phone to negotiate link speed
sleep 2

# Display all detected network interfaces
ifstat

# Attempt DHCP
dhcp || goto dhcp_failed

echo Connected successfully! Chainloading Arch Linux netboot...
chain --autofree https://archlinux.org/releng/netboot/archlinux.ipxe || goto boot_failed

:dhcp_failed
echo DHCP lease failed. Dropping to shell...
shell

:boot_failed
echo Chainloading failed. Dropping to shell...
shell
